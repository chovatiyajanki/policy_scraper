# PostgreSQL Database Connection URL
# Format: postgresql+psycopg://<username>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg://<username>:<password>@localhost:5432/vehicle_policy

# Server Configuration
HOST=127.0.0.1
PORT=8000

# ZYLA API CONFIGURATION (Zyla API Hub)
ZYLA_API_KEY=your_zyla_api_key_here
# Optional custom endpoint URL from your Zyla Labs dashboard subscription
# Example: https://zylalabs.com/api/2667/vehicle+rc+verification+api/2712/get+details
ZYLA_API_URL=
